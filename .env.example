# Application settings
APP_NAME="Coder Framework"
APP_ENV=development
APP_DEBUG=true
DEVELOPER_ENABLED=true
APP_URL=http://localhost/vayu

# Database settings
# SQLite local default; use DB_TYPE=mysql and your account settings in production.
DB_TYPE=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=database/database.sqlite
DB_USERNAME=root
DB_PASSWORD=secret

# SQLite paths are relative to Website/; MySQL uses DB_DATABASE as the schema name.

# Private runtime storage: absolute path OUTSIDE the HTTP document root.
# Default is ../var relative to Website; configure an account-private path on hosting.
# PRIVATE_STORAGE_PATH=/absolute/private/path
# Production always uses Secure cookies. Only listed direct proxy IPs may supply HTTPS.
SESSION_SECURE_COOKIE=false
TRUSTED_PROXIES=

# Customer signup defaults disabled. Enable only with migrated queue and a cron worker.
# Use AUTH_VERIFICATION_TRANSPORT=queue with MAIL_TRANSPORT=smtp (production HTTPS).
# Local queue testing uses MAIL_TRANSPORT=test; messages stay in private storage.
AUTH_REGISTRATION_ENABLED=false
AUTH_VERIFICATION_TRANSPORT=disabled

# 6-digit email OTP for register/login/forgot-password, plus trusted-device + PIN.
# To enable the OTP customer flow: AUTH_REGISTRATION_ENABLED=true, AUTH_OTP_ENABLED=true,
# AUTH_VERIFICATION_TRANSPORT=otp, and either MAIL_TRANSPORT=smtp (production) or, in a
# non-production APP_ENV, AUTH_OTP_CHANNEL=test (codes stay in private storage, never sent).
AUTH_OTP_ENABLED=false
AUTH_OTP_CHANNEL=test
AUTH_OTP_TTL_MINUTES=10
# Require an OTP on every verified login (trusted devices still skip it).
AUTH_LOGIN_OTP=false
AUTH_TRUSTED_DEVICE_DAYS=60

# No source credentials. Operator must rotate the previously embedded credential.
# SMTP is for worker use; customer auth never sends synchronous network mail.
MAIL_TRANSPORT=disabled
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Maa Sarada"
MAIL_TIMEOUT_SECONDS=10

# Worker: php vayu queue:work --queues=emails --max=20 --max-seconds=30
# Payload limits may be reduced; leases are 45s, attempts 5, backoff 10..3605s.
QUEUE_PAYLOAD_LIMIT=16384
CHECKOUT_SIMULATION_ENABLED=false
# Enable only after the store approves COD and configures delivery/tax policy.
CHECKOUT_COD_ENABLED=false
# Razorpay online payments (paise). COD and online can be enabled independently.
CHECKOUT_RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Test mode: create a free Razorpay account, use the rzp_test_... keys and the
# dashboard's test cards/UPI. Point the dashboard webhook at
# <APP_URL>/api/webhooks/razorpay with events payment.captured, payment.failed, order.paid
# and set RAZORPAY_WEBHOOK_SECRET to the secret you configure there.
# Flat shipping in paise and GST in basis points; admin settings override these defaults.
# 1800 = 18%; categories.tax_bps may override the store default. Operator must approve tax policy.
CHECKOUT_SHIPPING_MINOR=0
CHECKOUT_TAX_BPS=1800

# Public catalog cache only. Private files are versioned by authoritative SQL.
CACHE_DRIVER=file
# Optional Redis: file/SQL fallback works when the extension or connection is absent.
CACHE_REDIS_HOST=127.0.0.1
CACHE_REDIS_PORT=6379
CACHE_REDIS_PASSWORD=
