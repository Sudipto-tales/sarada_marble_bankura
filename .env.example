# Application settings
APP_NAME=Coder Framework
APP_ENV=development
APP_DEBUG=true
DEVELOPER_ENABLED=true
APP_URL=http://localhost/vayu

# Database settings
# SQLite local default; use DB_TYPE=mysql and your account settings in production.
DB_TYPE=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=database/database.sqlite
DB_USERNAME=root
DB_PASSWORD=secret

# SQLite paths are relative to Website/; MySQL uses DB_DATABASE as the schema name.

# Private runtime storage: absolute path OUTSIDE the HTTP document root.
# Default is ../var relative to Website; configure an account-private path on hosting.
# PRIVATE_STORAGE_PATH=/absolute/private/path
# Production always uses Secure cookies. Only listed direct proxy IPs may supply HTTPS.
SESSION_SECURE_COOKIE=false
TRUSTED_PROXIES=

# Customer signup defaults disabled. Enable only with migrated queue and a cron worker.
# Use AUTH_VERIFICATION_TRANSPORT=queue with MAIL_TRANSPORT=smtp (production HTTPS).
# Local queue testing uses MAIL_TRANSPORT=test; messages stay in private storage.
AUTH_REGISTRATION_ENABLED=false
AUTH_VERIFICATION_TRANSPORT=disabled

# No source credentials. Operator must rotate the previously embedded credential.
# SMTP is for worker use; customer auth never sends synchronous network mail.
MAIL_TRANSPORT=disabled
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Maa Sarada
MAIL_TIMEOUT_SECONDS=10

# Worker: php vayu queue:work --queues=emails --max=20 --max-seconds=30
# Payload limits may be reduced; leases are 45s, attempts 5, backoff 10..3605s.
QUEUE_PAYLOAD_LIMIT=16384
CHECKOUT_SIMULATION_ENABLED=false
# Local baseline: shipping 0 and tax 0. Operator must configure the real store policy.
CHECKOUT_SHIPPING_MINOR=0
CHECKOUT_TAX_BPS=0

# Public catalog cache only. Private files are versioned by authoritative SQL.
CACHE_DRIVER=file
# Optional Redis: file/SQL fallback works when the extension or connection is absent.
CACHE_REDIS_HOST=127.0.0.1
CACHE_REDIS_PORT=6379
CACHE_REDIS_PASSWORD=
