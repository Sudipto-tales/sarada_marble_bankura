Options -Indexes -ExecCGI
RemoveHandler .php .phtml .phar .cgi .pl .py .sh
<FilesMatch "\.(php[0-9]?|phtml|phar|cgi|pl|py|sh)$">
Require all denied
</FilesMatch>
<FilesMatch "\.(png|jpg|webp)$">
SetHandler none
<IfModule mod_headers.c>
Header set X-Content-Type-Options "nosniff"
</IfModule>
</FilesMatch>
