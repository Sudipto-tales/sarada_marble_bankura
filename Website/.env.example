# Application settings
APP_NAME=Coder Framework
APP_ENV=development
APP_DEBUG=true
DEVELOPER_ENABLED=true
APP_URL=http://localhost/vayu

# Database settings
# SQLite local default; use DB_TYPE=mysql and your account settings in production.
DB_TYPE=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=database/database.sqlite
DB_USERNAME=root
DB_PASSWORD=secret

# SQLite paths are relative to Website/; MySQL uses DB_DATABASE as the schema name.
